{
  "expo": {
    "name": "GospelAI",
    "slug": "gospelsai",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gospelsai",
    "userInterfaceStyle": "automatic",

    "extra": {
      "router": {},
      "eas": { "projectId": "bfed3b7e-5104-428d-bf14-175ec4baa880" }
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.steomi.gospelsai",
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#121212"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.steomi.gospelsai"
    },

    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#121212"
        }
      ],
      "expo-iap",
      "expo-font",
      "expo-secure-store",
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0",
            "useFrameworks": "static"
          }
        }
      ]

    ],

    "experiments": { "typedRoutes": true }
  }
}
