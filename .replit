modules = ["nodejs-20", "python-base-3.13", "postgresql-16"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run web"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build:web"]
run = ["node", "scripts/server.cjs"]

[userenv]

[userenv.shared]
LIBRARY_STORAGE_BUCKET_ID = "replit-objstore-39f35c6c-d21a-483a-b502-9a71688abd63"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 240000

[objectStorage]
defaultBucketID = "replit-objstore-39f35c6c-d21a-483a-b502-9a71688abd63"
